{
  "name": "@elvispdosreis/markflow-core",
  "version": "0.1.0",
  "description": "Shared runtime for the individual MarkFlow EmbedPDF extensions",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "preact": "^10.17.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/server-renderer": "3.5.43",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vue": "3.5.43",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@embedpdf/snippet": "2.15.0",
    "@embedpdf/models": "2.15.0",
    "@embedpdf/plugin-interaction-manager": "2.15.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0",
    "@embedpdf/plugin-scroll": "2.15.0",
    "@embedpdf/plugin-viewport": "2.15.0",
    "@embedpdf/plugin-zoom": "2.15.0",
    "@embedpdf/plugin-rotate": "2.15.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elvispdosreis/markflow-embedpdf-overlays.git",
    "directory": "packages/core"
  },
  "license": "UNLICENSED"
}
